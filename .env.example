# Copy this file to .env.local and fill in your values.
# For the demo, everything works with defaults (AI_MODE=mock needs no key).

# AI engine mode: "mock" (rule-based, zero config, works offline) or "groq" (real LLM)
AI_MODE=mock

# Required only when AI_MODE=groq — get a free key at https://console.groq.com
GROQ_API_KEY=

# Admin panel password — REQUIRED on production deploys.
# If unset in production, /admin and /api/bookings fail closed (503).
# Local dev default is demo123 when left empty.
ADMIN_PASSWORD=
